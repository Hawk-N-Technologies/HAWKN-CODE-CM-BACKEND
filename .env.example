# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.

NODE_ENV=development
PORT=3000

# Frontend origin (Vite dev server). Needed for CORS + cookies.
CLIENT_URL=http://localhost:5173

# --- Postgres (must match what you created in pgAdmin) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hawkn_db
DB_USER=hawkn_user
DB_PASSWORD=change_me
