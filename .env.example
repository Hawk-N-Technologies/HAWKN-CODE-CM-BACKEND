# Staging environment configuration
PORT_STAGE=12121
DATABASE_URL_STAGE=postgresql://username:password@hostname:12122/dbname
JWT_SECRET_STAGE=your-staging-secret-key

# Production environment configuration
PORT_PROD=43211
DATABASE_URL_PROD=postgresql://username:password@hostname:45645/dbname
JWT_SECRET_PROD=your-production-secret-key

# Active environment: staging / production
NODE_ENV=production
JWT_EXPIRES_IN=30d

# Optional overrides (will take precedence if provided)
# PORT=
# DATABASE_URL=
# JWT_SECRET=
# DEFAULT_COMPANY_ID=1
