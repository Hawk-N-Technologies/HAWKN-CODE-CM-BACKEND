# ---------------------------------------------------------------------------
# Active environment: development / staging / production
#  - development → uses PORT / DATABASE_URL / JWT_SECRET below
#  - staging     → uses the *_STAGE values (unless the plain ones are set)
#  - production  → uses the *_PROD values  (unless the plain ones are set)
# If NODE_ENV is missing the server assumes production.
# ---------------------------------------------------------------------------
NODE_ENV=development
JWT_EXPIRES_IN=30d
DEFAULT_COMPANY_ID=1

# Local development only. Plain values ALWAYS win over *_STAGE / *_PROD,
# so on the staging / live server remove these three lines.
PORT=3000
DATABASE_URL=postgresql://postgres:123456@localhost:5432/hawkn
JWT_SECRET=your-very-long-random-secret-key

# Staging environment configuration
PORT_STAGE=12121
DATABASE_URL_STAGE=postgresql://username:password@hostname:12122/dbname
JWT_SECRET_STAGE=your-staging-secret-key

# Production environment configuration
PORT_PROD=43211
DATABASE_URL_PROD=postgresql://username:password@hostname:45645/dbname
JWT_SECRET_PROD=your-production-secret-key

# Extra portal addresses allowed to call the API (comma-separated).
# https://clientportal.hawkntechnologies.com is always allowed.
FRONTEND_URL=

# Phone / laptop alerts — generate once with:  npx web-push generate-vapid-keys
# Use a NEW pair on the live server. Leave empty to turn alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@hawkntechnologies.com

# ---------------------------------------------------------------------------
# Live server only (NODE_ENV=production)
#  - The JWT secret must be 32+ random characters, e.g.:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#  - `npm run seed` (demo accounts) is blocked. On a clean live database run
#    `npm run setup:production` once, with these set for that one command:
# COMPANY_NAME=Hawk'N Technologies
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_PASSWORD=
# FIRST_ADMIN_FIRST_NAME=
# FIRST_ADMIN_LAST_NAME=
# ---------------------------------------------------------------------------
