PORT=3000
DATABASE_URL=postgresql://postgres:123456@localhost:5432/hawkn
DEFAULT_COMPANY_ID=1
NODE_ENV=development
JWT_SECRET=your-very-long-random-secret-key
JWT_EXPIRES_IN=30d

# Extra portal addresses allowed to call the API (comma-separated).
# https://clientportal.hawkntechnologies.com is always allowed.
FRONTEND_URL=

# Phone / laptop alerts — generate once with:  npx web-push generate-vapid-keys
# Use a NEW pair on the live server. Leave empty to turn alerts off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@hawkntechnologies.com

# ---------------------------------------------------------------------------
# Live server only (NODE_ENV=production)
#  - JWT_SECRET must be 32+ random characters, e.g.:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#  - `npm run seed` (demo accounts) is blocked. On a clean live database run
#    `npm run setup:production` once, with these set for that one command:
# COMPANY_NAME=Hawk'N Technologies
# FIRST_ADMIN_EMAIL=
# FIRST_ADMIN_PASSWORD=
# FIRST_ADMIN_FIRST_NAME=
# FIRST_ADMIN_LAST_NAME=
# ---------------------------------------------------------------------------
