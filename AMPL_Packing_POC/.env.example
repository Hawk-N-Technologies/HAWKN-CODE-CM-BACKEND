# ==============================================================================
# AMPL Packing POC backend. Copy to .env and fill in. Never commit .env.
# ==============================================================================

# --- Django ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true only on your own machine
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=ampl-pocapi.hawkntechnologies.com,localhost,127.0.0.1
# Every address the app is opened from.
DJANGO_CSRF_TRUSTED_ORIGINS=https://ampl-poc.hawkntechnologies.com,https://ampl-pocapi.hawkntechnologies.com,http://localhost:5180,http://127.0.0.1:5180,http://localhost:18000,http://127.0.0.1:18000
DJANGO_CORS_ALLOWED_ORIGINS=https://ampl-poc.hawkntechnologies.com,http://localhost:5180,http://127.0.0.1:5180
# Domain for cookies (set to .hawkntechnologies.com in production so cookies share across subdomains)
# DJANGO_SESSION_COOKIE_DOMAIN=.hawkntechnologies.com
# DJANGO_CSRF_COOKIE_DOMAIN=.hawkntechnologies.com
# DJANGO_SESSION_COOKIE_SAMESITE=Lax
# DJANGO_CSRF_COOKIE_SAMESITE=Lax
# false for local http; true on the HTTPS server
DJANGO_COOKIE_SECURE=false
# true only when running behind nginx with HTTPS
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (database ampl-poc) ---
# Supports either full DATABASE_URL or individual DB_* settings:
DATABASE_URL=postgresql://pocampl:UBSMhLfgnOeDKeWi6BzH@194.164.148.10:17999/ampl-poc
DB_NAME=ampl-poc
DB_USER=pocampl
DB_PASSWORD=UBSMhLfgnOeDKeWi6BzH
DB_HOST=194.164.148.10
DB_PORT=17999
# Temporary database Django creates when running tests
DB_TEST_NAME=test_ampl_poc
# Seconds to keep a database connection open. 0 for local development; 60 on the server.
DB_CONN_MAX_AGE=0

# --- Server ---
PORT=18000
