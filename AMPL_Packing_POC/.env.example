# ==============================================================================
# AMPL Packing POC backend. Copy to .env and fill in. Never commit .env.
# ==============================================================================

# --- Django ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true only on your own machine
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Every address the app is opened from. For phone testing add your Mac's https address,
# e.g. https://192.168.1.20:5180 (find the IP with: ipconfig getifaddr en0)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# false for local http; true on the HTTPS server
DJANGO_COOKIE_SECURE=false
# true only when running behind nginx with HTTPS
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (separate database on the existing HawkN server) ---
DB_NAME=ampl_packing_poc
DB_USER=ampl_poc_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Temporary database Django creates when running tests
DB_TEST_NAME=test_ampl_packing_poc

# --- Server ---
PORT=8010
