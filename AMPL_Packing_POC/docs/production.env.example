# ==============================================================================
# AMPL Packing POC backend - PRODUCTION settings (copy to the server as .env,
# or set as real environment variables). Never commit real values.
# Example domain below: ampl-poc.hawkntechnologies.com - replace with yours.
# ==============================================================================

# --- Django ---
# New random value for the server (do not reuse your laptop's):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ampl-poc.hawkntechnologies.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ampl-poc.hawkntechnologies.com
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (nginx terminates HTTPS and forwards to gunicorn) ---
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
# Start with 3600 (1 hour). Raise to 31536000 (1 year) once HTTPS is confirmed working.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true

# --- PostgreSQL (separate database on the HawkN PostgreSQL server) ---
DB_NAME=ampl_packing_poc
DB_USER=ampl_poc_user
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# Reuse connections under gunicorn (do NOT use 60 with "runserver")
DB_CONN_MAX_AGE=60

# --- Server ---
PORT=8010
GUNICORN_WORKERS=3
