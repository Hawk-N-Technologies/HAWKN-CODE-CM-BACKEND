# ==============================================================================
# AMPL Packing POC backend - PRODUCTION settings (copy to the server as .env,
# or set as real environment variables). Never commit real values.
# Backend domain: ampl-pocapi.hawkntechnologies.com
# Frontend domain: https://ampl-poc.hawkntechnologies.com/
# ==============================================================================

# --- Django ---
# New random value for the server (do not reuse your laptop's):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ampl-pocapi.hawkntechnologies.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ampl-poc.hawkntechnologies.com,https://ampl-pocapi.hawkntechnologies.com
DJANGO_CORS_ALLOWED_ORIGINS=https://ampl-poc.hawkntechnologies.com
DJANGO_SESSION_COOKIE_DOMAIN=.hawkntechnologies.com
DJANGO_CSRF_COOKIE_DOMAIN=.hawkntechnologies.com
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (nginx terminates HTTPS and forwards to gunicorn) ---
DJANGO_BEHIND_HTTPS_PROXY=true
DJANGO_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
# Start with 3600 (1 hour). Raise to 31536000 (1 year) once HTTPS is confirmed working.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true

# --- PostgreSQL (database ampl-poc) ---
# Supports either full DATABASE_URL or individual DB_* settings:
DATABASE_URL=postgresql://pocampl:UBSMhLfgnOeDKeWi6BzH@194.164.148.10:17999/ampl-poc
DB_NAME=ampl-poc
DB_USER=pocampl
DB_PASSWORD=UBSMhLfgnOeDKeWi6BzH
DB_HOST=194.164.148.10
DB_PORT=17999
# Reuse connections under gunicorn (do NOT use 60 with "runserver")
DB_CONN_MAX_AGE=60

# --- Server ---
PORT=18000
GUNICORN_WORKERS=3
